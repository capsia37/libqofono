prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/qofono-qt@QT_MAJOR_VERSION@

Name: qofono-qt@QT_MAJOR_VERSION@
Description: Qt bindings for ofono
Version: @PROJECT_VERSION@
